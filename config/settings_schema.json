[
  {
    "name": "theme_info",
    "theme_name": "Fusion Flow",
    "theme_version": "1.0.0",
    "theme_author": "ZILLEALI",
    "theme_documentation_url": "https://zilleali.com",
    "theme_support_url": "https://zilleali.com/contact"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#D8C9AE"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color",
        "default": "#575757"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#333333"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background color",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "mosafin"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "mosafin"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "Enable sticky header",
        "default": true
      },
      {
        "type": "select",
        "id": "header_layout",
        "label": "Header layout",
        "options": [
          {
            "value": "layout-1",
            "label": "Layout 1"
          },
          {
            "value": "layout-2",
            "label": "Layout 2"
          },
          {
            "value": "layout-3",
            "label": "Layout 3"
          }
        ],
        "default": "layout-1"
      },
      {
        "type": "header",
        "content": "Top bar"
      },
      {
        "type": "checkbox",
        "id": "show_top_bar",
        "label": "Show top bar",
        "default": true
      },
      {
        "type": "text",
        "id": "top_bar_text",
        "label": "Top bar text",
        "default": "Free shipping on all orders over $50"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "ajax_cart_enable",
        "label": "Enable Ajax cart",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Enable cart notes",
        "default": true
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_zoom_enable",
        "label": "Enable image zoom",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_vendor_enable",
        "label": "Show product vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_sku_enable",
        "label": "Show product SKU",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_quantity_enable",
        "label": "Show quantity selector",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "dynamic_checkout_enable",
        "label": "Show dynamic checkout button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_swatches_enable",
        "label": "Enable color swatches",
        "default": true
      }
    ]
  },
  {
    "name": "Blog",
    "settings": [
      {
        "type": "select",
        "id": "blog_layout",
        "label": "Blog layout",
        "options": [
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "alternative",
            "label": "Alternative"
          },
          {
            "value": "small_images",
            "label": "Small images"
          },
          {
            "value": "chess",
            "label": "Chess"
          },
          {
            "value": "masonry",
            "label": "Masonry"
          }
        ],
        "default": "default"
      },
      {
        "type": "checkbox",
        "id": "blog_show_author",
        "label": "Show author",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "blog_show_date",
        "label": "Show date",
        "default": true
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "Show social icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_copyright",
        "label": "Show copyright",
        "default": true
      },
      {
        "type": "text",
        "id": "copyright_text",
        "label": "Copyright text",
        "default": "© 2023 Your Store Name. All rights reserved."
      }
    ]
  }
]