{%- liquid
  assign end_date = end_date | default: false
  assign heading = heading | default: false
  assign text = text | default: false
  assign hide_on_complete = hide_on_complete | default: false
  assign restart_delay = restart_delay | default: 0
  assign timer_style = timer_style | default: 'compact'
  assign show_days = show_days | default: true
  assign show_hours = show_hours | default: true
  assign show_minutes = show_minutes | default: true
  assign show_seconds = show_seconds | default: true
-%}

{% if end_date %}
  <div class="countdown-timer countdown-timer--{{ timer_style }}" 
       data-countdown-timer
       data-end-date="{{ end_date }}"
       data-hide-on-complete="{{ hide_on_complete }}"
       data-restart-delay="{{ restart_delay }}"
       data-show-days="{{ show_days }}"
       data-show-hours="{{ show_hours }}"
       data-show-minutes="{{ show_minutes }}"
       data-show-seconds="{{ show_seconds }}">
    {% if heading %}
      <h3 class="countdown-timer__heading">{{ heading }}</h3>
    {% endif %}

    <div class="countdown-timer__display">
      {% if show_days %}
        <div class="countdown-timer__segment countdown-timer__days">
          <span class="countdown-timer__number" data-days>00</span>
          <span class="countdown-timer__label">{{ 'general.countdown.days' | t }}</span>
        </div>
      {% endif %}

      {% if show_hours %}
        <div class="countdown-timer__segment countdown-timer__hours">
          <span class="countdown-timer__number" data-hours>00</span>
          <span class="countdown-timer__label">{{ 'general.countdown.hours' | t }}</span>
        </div>
      {% endif %}

      {% if show_minutes %}
        <div class="countdown-timer__segment countdown-timer__minutes">
          <span class="countdown-timer__number" data-minutes>00</span>
          <span class="countdown-timer__label">{{ 'general.countdown.minutes' | t }}</span>
        </div>
      {% endif %}

      {% if show_seconds %}
        <div class="countdown-timer__segment countdown-timer__seconds">
          <span class="countdown-timer__number" data-seconds>00</span>
          <span class="countdown-timer__label">{{ 'general.countdown.seconds' | t }}</span>
        </div>
      {% endif %}
    </div>

    {% if text %}
      <div class="countdown-timer__text">{{ text }}</div>
    {% endif %}
  </div>
{% endif %}

<style>
  .countdown-timer {
    text-align: center;
    padding: 20px;
    background-color: #f5f5f5;
    border-radius: 4px;
  }

  .countdown-timer__heading {
    margin: 0 0 15px;
    font-size: 1.25rem;
  }

  .countdown-timer__display {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .countdown-timer__segment {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 60px;
  }

  .countdown-timer__number {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .countdown-timer__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .countdown-timer__text {
    font-size: 0.875rem;
  }

  /* Compact style */
  .countdown-timer--compact .countdown-timer__display {
    gap: 5px;
  }

  .countdown-timer--compact .countdown-timer__segment {
    min-width: 40px;
  }

  .countdown-timer--compact .countdown-timer__number {
    font-size: 1.25rem;
  }

  /* Inline style */
  .countdown-timer--inline {
    display: inline-block;
    padding: 10px 15px;
  }

  .countdown-timer--inline .countdown-timer__display {
    display: inline-flex;
    margin: 0;
  }

  .countdown-timer--inline .countdown-timer__segment {
    flex-direction: row;
    min-width: auto;
    gap: 5px;
  }

  .countdown-timer--inline .countdown-timer__number {
    font-size: 1rem;
  }

  .countdown-timer--inline .countdown-timer__label {
    font-size: 0.6875rem;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const timers = document.querySelectorAll('[data-countdown-timer]');
  
  timers.forEach(timer => {
    const endDate = timer.dataset.endDate;
    const hideOnComplete = timer.dataset.hideOnComplete === 'true';
    const restartDelay = parseInt(timer.dataset.restartDelay) || 0;
    const showDays = timer.dataset.showDays === 'true';
    const showHours = timer.dataset.showHours === 'true';
    const showMinutes = timer.dataset.showMinutes === 'true';
    const showSeconds = timer.dataset.showSeconds === 'true';
    
    // Parse end date (format: YYYY-MM-DD or YYYY/MM/DD)
    const dateParts = endDate.split(/[-/]/);
    const year = parseInt(dateParts[0]);
    const month = parseInt(dateParts[1]) - 1; // Months are 0-indexed
    const day = parseInt(dateParts[2]);
    const endTime = new Date(year, month, day, 23, 59, 59).getTime();
    
    // Start countdown
    const countdown = setInterval(function() {
      const now = new Date().getTime();
      const distance = endTime - now;
      
      // Time calculations
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      
      // Update display
      if (showDays && timer.querySelector('[data-days]')) {
        timer.querySelector('[data-days]').textContent = days.toString().padStart(2, '0');
      }
      
      if (showHours && timer.querySelector('[data-hours]')) {
        timer.querySelector('[data-hours]').textContent = hours.toString().padStart(2, '0');
      }
      
      if (showMinutes && timer.querySelector('[data-minutes]')) {
        timer.querySelector('[data-minutes]').textContent = minutes.toString().padStart(2, '0');
      }
      
      if (showSeconds && timer.querySelector('[data-seconds]')) {
        timer.querySelector('[data-seconds]').textContent = seconds.toString().padStart(2, '0');
      }
      
      // If countdown is finished
      if (distance < 0) {
        clearInterval(countdown);
        
        if (hideOnComplete) {
          timer.style.display = 'none';
        } else {
          timer.querySelector('.countdown-timer__display').innerHTML = 
            '<div class="countdown-timer__expired">' + 
            '{{ "general.countdown.expired" | t }}' + 
            '</div>';
        }
        
        // Restart countdown after delay if specified
        if (restartDelay > 0) {
          setTimeout(() => {
            const newEndDate = new Date();
            newEndDate.setDate(newEndDate.getDate() + restartDelay);
            timer.dataset.endDate = newEndDate.toISOString().split('T')[0];
            timer.style.display = '';
            startCountdown(timer);
          }, 1000);
        }
      }
    }, 1000);
  });
  
  function startCountdown(timer) {
    // Same countdown logic as above
    // Can be extracted to a function if needed for restart functionality
  }
});
</script>