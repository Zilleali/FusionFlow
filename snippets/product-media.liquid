{%- liquid
  assign media_class = 'product-media'
  assign media_wrapper_class = 'product-media__wrapper'
  
  if media.id == featured_media.id
    assign media_class = media_class | append: ' active'
  endif
  
  case media.media_type
    when 'image'
      assign media_class = media_class | append: ' product-media--image'
    when 'external_video'
      assign media_class = media_class | append: ' product-media--video'
      assign media_wrapper_class = media_wrapper_class | append: ' product-media__wrapper--video'
    when 'video'
      assign media_class = media_class | append: ' product-media--video'
      assign media_wrapper_class = media_wrapper_class | append: ' product-media__wrapper--video'
    when 'model'
      assign media_class = media_class | append: ' product-media--model'
      assign media_wrapper_class = media_wrapper_class | append: ' product-media__wrapper--model'
    else
      assign media_class = media_class | append: ' product-media--other'
  endcase
-%}

<div class="{{ media_class }}" data-product-media>
  <div class="{{ media_wrapper_class }}">
    {% case media.media_type %}
      {% when 'image' %}
        <img src="{{ media | img_url: '1200x' }}"
             srcset="{% render 'responsive-srcset', image: media %}"
             sizes="(min-width: 1200px) 1200px, 100vw"
             alt="{{ media.alt | escape }}"
             loading="lazy"
             width="{{ media.width }}"
             height="{{ media.height }}"
             data-zoom-src="{{ media | img_url: '2400x' }}"
             data-product-image>
      
      {% when 'external_video' %}
        <div class="product-media__video" style="padding-bottom: {{ 1 | divided_by: media.aspect_ratio | times: 100 }}%;">
          {{ media | external_video_tag: loading: "lazy" }}
        </div>
      
      {% when 'video' %}
        <div class="product-media__video" style="padding-bottom: {{ 1 | divided_by: media.aspect_ratio | times: 100 }}%;">
          {{ media | video_tag: controls: true, loading: "lazy" }}
        </div>
      
      {% when 'model' %}
        <div class="product-media__model" style="padding-bottom: 100%;">
          {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, auto-rotate: true, camera-controls: true }}
        </div>
    {% endcase %}
  </div>
</div>

<style>
  .product-media {
    display: none;
  }
  
  .product-media.active {
    display: block;
  }
  
  .product-media__wrapper {
    position: relative;
  }
  
  .product-media--image img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .product-media__video,
  .product-media__model {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  
  .product-media__video iframe,
  .product-media__video video,
  .product-media__model model-viewer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .product-media__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background-color: rgba(255,255,255,0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1;
  }
</style>