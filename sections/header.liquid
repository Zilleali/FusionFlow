{% liquid
  assign logo_width = section.settings.logo_width | default: 180
  assign logo_height = logo_width | divided_by: section.settings.logo.aspect_ratio | default: 60
%}

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <div class="header-logo">
        <a href="{{ routes.root_url }}">
          {% if section.settings.logo %}
            <img src="{{ section.settings.logo | image_url: width: logo_width }}" 
                 alt="{{ shop.name }}" 
                 width="{{ logo_width }}" 
                 height="{{ logo_height }}">
          {% else %}
            <span class="h2">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>
      
      <nav class="header-nav">
        <ul class="nav-list">
          {% for link in linklists.main-menu.links %}
            <li class="nav-item">
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
      
      <div class="header-actions">
        <a href="{{ routes.cart_url }}" class="cart-link">
          Cart ({{ cart.item_count }})
        </a>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 180
    }
  ]
}
{% endschema %}