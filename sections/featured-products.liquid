{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
  assign columns = section.settings.columns
  assign show_view_all = section.settings.show_view_all
  assign view_all_text = section.settings.view_all_text
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
-%}

<style>
  .featured-products {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    background-color: var(--bg-color);
    color: var(--text-color);
  }
  
  .featured-products a {
    color: var(--text-color);
  }
</style>

<div class="featured-products">
  <div class="container">
    {% if heading != blank or description != blank %}
      <div class="section-heading text-center">
        {% if heading != blank %}
          <h2 class="section-heading__title">{{ heading }}</h2>
        {% endif %}
        
        {% if description != blank %}
          <div class="section-heading__description">{{ description }}</div>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="featured-products__grid grid grid--{{ columns }}-col-desktop grid--2-col-tablet grid--1-col-mobile">
      {% if collection != blank %}
        {% for product in collection.products limit: product_limit %}
          <div class="featured-products__item grid__item">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..product_limit) %}
          <div class="featured-products__item grid__item">
            <div class="product-card">
              <div class="product-card__image">
                <div class="placeholder-background">
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'homepage.onboarding.product_title' | t }}</h3>
                <div class="product-card__price">{{ 1999 | money }}</div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    
    {% if show_view_all and view_all_text != blank and collection != blank %}
      <div class="featured-products__footer text-center">
        <a href="{{ collection.url }}" class="featured-products__view-all button button--primary">
          {{ view_all_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .featured-products {
    padding: 60px 0;
  }
  
  .featured-products__grid {
    gap: 30px;
    margin-bottom: 30px;
  }
  
  .featured-products__footer {
    margin-top: 30px;
  }
  
  @media (max-width: 767px) {
    .featured-products {
      padding: 40px 0;
    }
  }
</style>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button text",
      "default": "View all products"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Collection"
    }
  ]
}
{% endschema %}