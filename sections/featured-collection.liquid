{%- liquid
  assign collection = collections[section.settings.collection]
  assign product_limit = section.settings.product_limit
  assign columns = section.settings.columns
  assign show_view_all = section.settings.show_view_all
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign button_style = section.settings.button_style
-%}

<style>
  #shopify-section-{{ section.id }} {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --primary-color: {{ settings.color_primary }};
    --secondary-color: {{ settings.color_secondary }};
    background-color: var(--bg-color);
    color: var(--text-color);
  }
  
  #shopify-section-{{ section.id }} .section-heading {
    color: var(--text-color);
  }
  
  #shopify-section-{{ section.id }} .product-card__title {
    color: var(--text-color);
  }
  
  #shopify-section-{{ section.id }} .product-card__price {
    color: var(--text-color);
  }
</style>

<section class="section featured-collection" data-section-id="{{ section.id }}" data-section-type="featured-collection">
  <div class="container">
    {%- if heading != blank or description != blank -%}
      <div class="section-heading text-center">
        {%- if heading != blank -%}
          <h2 class="section-heading__title">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <div class="section-heading__description rte">{{ description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="featured-collection__products grid grid--{{ columns }}-col-desktop grid--2-col-tablet grid--1-col-mobile">
      {%- for product in collection.products limit: product_limit -%}
        <div class="grid__item">
          {% render 'product-card',
            product: product,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            show_quick_view: section.settings.show_quick_view,
            show_add_to_cart: section.settings.show_add_to_cart
          %}
        </div>
      {%- else -%}
        {%- for i in (1..product_limit) -%}
          <div class="grid__item">
            <div class="product-card">
              <div class="product-card__image-wrapper">
                <div class="product-card__image placeholder-image">
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'homepage.onboarding.product_title' | t }}</h3>
                <div class="product-card__price">
                  {{ 1999 | money }}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    
    {%- if show_view_all and collection != blank -%}
      <div class="featured-collection__footer text-center">
        <a href="{{ collection.url }}" class="button button--{{ button_style }}">
          {{ 'collections.general.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show product rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_view",
      "label": "Show quick view button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}