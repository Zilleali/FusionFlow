{%- liquid
  assign blocks_count = section.blocks.size
  assign columns = columns | default: 4
  assign show_social = section.settings.show_social
  assign show_payment_icons = section.settings.show_payment_icons
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign link_color = section.settings.link_color
  assign heading_color = section.settings.heading_color
-%}

<style>
  .footer {
    --footer-bg: {{ bg_color }};
    --footer-text: {{ text_color }};
    --footer-link: {{ link_color }};
    --footer-heading: {{ heading_color }};
    background-color: var(--footer-bg);
    color: var(--footer-text);
  }
  
  .footer a {
    color: var(--footer-link);
  }
  
  .footer__title {
    color: var(--footer-heading);
  }
  
  {% if section.settings.enable_sticky %}
    @media (min-width: 992px) {
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      
      .content-for-layout {
        flex: 1;
      }
    }
  {% endif %}
</style>

<footer class="footer" role="contentinfo">
  <div class="container">
    {% if blocks_count > 0 %}
      <div class="footer__grid grid grid--{{ columns }}-col-desktop grid--2-col-tablet grid--1-col-mobile">
        {% for block in section.blocks %}
          <div class="footer__block grid__item" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'menu' %}
                <h3 class="footer__title">{{ block.settings.heading }}</h3>
                <ul class="footer__links">
                  {% for link in linklists[block.settings.menu].links %}
                    <li class="footer__link-item">
                      <a href="{{ link.url }}" class="footer__link">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              
              {% when 'text' %}
                <h3 class="footer__title">{{ block.settings.heading }}</h3>
                <div class="footer__text rte">
                  {{ block.settings.text }}
                </div>
                
                {% if show_social and block.settings.show_social %}
                  <div class="footer__social">
                    {% render 'social-links' %}
                  </div>
                {% endif %}
              
              {% when 'newsletter' %}
                <h3 class="footer__title">{{ block.settings.heading }}</h3>
                <div class="footer__text rte">
                  {{ block.settings.text }}
                </div>
                
                {% form 'customer', class: 'footer__newsletter' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="footer__newsletter-inner">
                    <input type="email"
                           name="contact[email]"
                           class="footer__newsletter-input"
                           value=""
                           placeholder="{{ 'general.newsletter.placeholder' | t }}"
                           aria-label="{{ 'general.newsletter.placeholder' | t }}"
                           required>
                    <button type="submit" class="footer__newsletter-button button button--secondary">
                      {{ 'general.newsletter.submit' | t }}
                    </button>
                  </div>
                  
                  {% if form.posted_successfully? %}
                    <div class="footer__newsletter-message">
                      {{ 'general.newsletter.success' | t }}
                    </div>
                  {% elsif form.errors %}
                    <div class="footer__newsletter-message">
                      {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                    </div>
                  {% endif %}
                {% endform %}
            {% endcase %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
    
    <div class="footer__bottom">
      <div class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.bottom.copyright' | t }}
      </div>
      
      {% if show_payment_icons %}
        <div class="footer__payment-icons">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 60px 0 30px;
  }
  
  .footer__grid {
    margin-bottom: 60px;
  }
  
  .footer__block {
    margin-bottom: 30px;
  }
  
  .footer__title {
    font-size: 1.125rem;
    margin: 0 0 20px;
  }
  
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .footer__link-item {
    margin-bottom: 10px;
  }
  
  .footer__link {
    transition: opacity 0.2s ease;
  }
  
  .footer__link:hover {
    opacity: 0.8;
  }
  
  .footer__text {
    margin-bottom: 20px;
  }
  
  .footer__social {
    margin-top: 20px;
  }
  
  .footer__newsletter {
    margin-top: 20px;
  }
  
  .footer__newsletter-inner {
    display: flex;
  }
  
  .footer__newsletter-input {
    flex: 1;
    min-width: 0;
    padding: 10px 15px;
    border: 1px solid rgba(255,255,255,0.2);
    background-color: rgba(255,255,255,0.1);
    color: inherit;
  }
  
  .footer__newsletter-button {
    border-radius: 0 4px 4px 0;
  }
  
  .footer__newsletter-message {
    margin-top: 10px;
    font-size: 0.875rem;
  }
  
  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  
  .footer__copyright {
    font-size: 0.875rem;
    margin-bottom: 20px;
    text-align: center;
  }
  
  .footer__payment-icons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  
  .footer__payment-icon {
    width: 40px;
    height: 25px;
  }
  
  @media (min-width: 768px) {
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    
    .footer__copyright {
      margin-bottom: 0;
      text-align: left;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky footer",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#575757"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, promotions, or brand content with your customers.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Subscribe to our newsletter for the latest updates.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu"
      },
      {
        "type": "menu"
      },
      {
        "type": "text"
      },
      {
        "type": "newsletter"
      }
    ]
  }
}
{% endschema %}