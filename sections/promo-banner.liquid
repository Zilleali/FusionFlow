{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign button_text = section.settings.button_text
  assign button_link = section.settings.button_link
  assign text_position = section.settings.text_position
  assign color_scheme = section.settings.color_scheme
  assign overlay_opacity = section.settings.overlay_opacity
  assign height = section.settings.height
-%}

<div class="promo-banner promo-banner--{{ height }} promo-banner--{{ text_position }} color-{{ color_scheme }}">
  <div class="promo-banner__image">
    {% if image != blank %}
      <picture>
        <source media="(max-width: 767px)" srcset="{{ mobile_image | img_url: '800x' }} 1x, {{ mobile_image | img_url: '1600x' }} 2x">
        <source media="(min-width: 768px)" srcset="{{ image | img_url: '1200x' }} 1x, {{ image | img_url: '2400x' }} 2x">
        <img src="{{ image | img_url: '1200x' }}" 
             alt="{{ image.alt | escape }}" 
             loading="lazy" 
             width="{{ image.width }}" 
             height="{{ image.height }}">
      </picture>
    {% else %}
      <div class="placeholder-background">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
    
    <div class="promo-banner__overlay" style="opacity: {{ overlay_opacity | divided_by: 100.0 }};"></div>
  </div>

  <div class="promo-banner__content">
    <div class="container">
      {% if heading != blank %}
        <h2 class="promo-banner__heading">{{ heading }}</h2>
      {% endif %}
      
      {% if text != blank %}
        <div class="promo-banner__text">{{ text }}</div>
      {% endif %}
      
      {% if button_text != blank %}
        <a href="{{ button_link }}" class="promo-banner__button button button--primary">
          {{ button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .promo-banner {
    position: relative;
    margin: 60px 0;
  }
  
  .promo-banner--small {
    height: 300px;
  }
  
  .promo-banner--medium {
    height: 400px;
  }
  
  .promo-banner--large {
    height: 500px;
  }
  
  .promo-banner__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  
  .promo-banner__image img,
  .promo-banner__image .placeholder-background {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .promo-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
  }
  
  .promo-banner__content {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 40px 0;
    z-index: 1;
  }
  
  .promo-banner__heading {
    margin: 0 0 15px;
    font-size: 2rem;
  }
  
  .promo-banner__text {
    margin-bottom: 20px;
    font-size: 1.25rem;
  }
  
  /* Text position variations */
  .promo-banner--left .promo-banner__content {
    justify-content: flex-start;
    text-align: left;
  }
  
  .promo-banner--right .promo-banner__content {
    justify-content: flex-end;
    text-align: right;
  }
  
  .promo-banner--center .promo-banner__content {
    justify-content: center;
    text-align: center;
  }
  
  /* Color schemes */
  .promo-banner.color-light {
    color: #fff;
  }
  
  .promo-banner.color-dark {
    color: #333;
  }
  
  @media (max-width: 767px) {
    .promo-banner {
      margin: 40px 0;
    }
    
    .promo-banner--small {
      height: 250px;
    }
    
    .promo-banner--medium {
      height: 300px;
    }
    
    .promo-banner--large {
      height: 350px;
    }
    
    .promo-banner__heading {
      font-size: 1.5rem;
    }
    
    .promo-banner__text {
      font-size: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Recommended size: 1800x800px"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Recommended size: 800x1000px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Promo banner heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Promo banner description</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    }
  ],
  "presets": [
    {
      "name": "Promo banner",
      "category": "Image"
    }
  ]
}
{% endschema %}