{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign button_bg_color = section.settings.button_bg_color
  assign button_text_color = section.settings.button_text_color
-%}

<style>
  .newsletter {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    --button-bg-color: {{ button_bg_color }};
    --button-text-color: {{ button_text_color }};
    background-color: var(--bg-color);
    color: var(--text-color);
  }
  
  .newsletter a {
    color: var(--text-color);
  }
  
  .newsletter__button {
    background-color: var(--button-bg-color);
    color: var(--button-text-color);
    border-color: var(--button-bg-color);
  }
  
  .newsletter__button:hover {
    opacity: 0.9;
  }
</style>

<div class="newsletter">
  <div class="container">
    <div class="newsletter__inner">
      <div class="newsletter__content">
        {% if heading != blank %}
          <h2 class="newsletter__heading">{{ heading }}</h2>
        {% endif %}
        
        {% if description != blank %}
          <div class="newsletter__description">{{ description }}</div>
        {% endif %}
      </div>
      
      <div class="newsletter__form">
        {% form 'customer', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          <div class="newsletter-form__inner">
            <div class="newsletter-form__field">
              <input type="email"
                     name="contact[email]"
                     class="newsletter-form__input"
                     value=""
                     placeholder="{{ 'general.newsletter.placeholder' | t }}"
                     aria-label="{{ 'general.newsletter.placeholder' | t }}"
                     required>
            </div>
            
            <button type="submit" class="newsletter-form__button newsletter__button button">
              {{ 'general.newsletter.submit' | t }}
            </button>
          </div>
          
          {% if form.posted_successfully? %}
            <div class="newsletter-form__message newsletter-form__message--success">
              {{ 'general.newsletter.success' | t }}
            </div>
          {% elsif form.errors %}
            <div class="newsletter-form__message newsletter-form__message--error">
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</div>

<style>
  .newsletter {
    padding: 60px 0;
  }
  
  .newsletter__inner {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  
  .newsletter__heading {
    margin: 0 0 15px;
    font-size: 2rem;
  }
  
  .newsletter__description {
    opacity: 0.8;
  }
  
  .newsletter-form__inner {
    display: flex;
  }
  
  .newsletter-form__field {
    flex: 1;
    min-width: 0;
  }
  
  .newsletter-form__input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid rgba(255,255,255,0.2);
    background-color: rgba(255,255,255,0.1);
    color: inherit;
  }
  
  .newsletter-form__button {
    border-radius: 0 4px 4px 0;
  }
  
  .newsletter-form__message {
    margin-top: 10px;
  }
  
  .newsletter-form__message--success {
    color: #4caf50;
  }
  
  .newsletter-form__message--error {
    color: #f44336;
  }
  
  @media (max-width: 991px) {
    .newsletter__inner {
      grid-template-columns: 1fr;
      gap: 30px;
      text-align: center;
    }
    
    .newsletter-form__inner {
      max-width: 500px;
      margin: 0 auto;
    }
  }
  
  @media (max-width: 767px) {
    .newsletter {
      padding: 40px 0;
    }
    
    .newsletter__heading {
      font-size: 1.5rem;
    }
    
    .newsletter-form__inner {
      flex-direction: column;
      gap: 10px;
    }
    
    .newsletter-form__button {
      width: 100%;
      border-radius: 4px;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Receive updates, promotions, and more.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#575757"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#D8C9AE"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Promotional"
    }
  ]
}
{% endschema %}