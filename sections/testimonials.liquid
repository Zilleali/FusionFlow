{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign testimonials = section.blocks | where: 'type', 'testimonial'
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
-%}

<style>
  .testimonials {
    --bg-color: {{ bg_color }};
    --text-color: {{ text_color }};
    background-color: var(--bg-color);
    color: var(--text-color);
  }
  
  .testimonials a {
    color: var(--text-color);
  }
</style>

<div class="testimonials">
  <div class="container">
    {% if heading != blank or description != blank %}
      <div class="section-heading text-center">
        {% if heading != blank %}
          <h2 class="section-heading__title">{{ heading }}</h2>
        {% endif %}
        
        {% if description != blank %}
          <div class="section-heading__description">{{ description }}</div>
        {% endif %}
      </div>
    {% endif %}
    
    {% if testimonials.size > 0 %}
      <div class="testimonials__slider" data-testimonials-slider>
        <div class="testimonials__slides" data-slides>
          {% for block in testimonials %}
            {%- liquid
              assign text = block.settings.text
              assign author = block.settings.author
              assign rating = block.settings.rating
            -%}
            
            <div class="testimonials__slide" {{ block.shopify_attributes }}>
              <div class="testimonials__content">
                {% if rating > 0 %}
                  <div class="testimonials__rating">
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        {% render 'icon-star' %}
                      {% else %}
                        {% render 'icon-star-empty' %}
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
                
                {% if text != blank %}
                  <blockquote class="testimonials__text">{{ text }}</blockquote>
                {% endif %}
                
                {% if author != blank %}
                  <cite class="testimonials__author">{{ author }}</cite>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        
        {% if testimonials.size > 1 %}
          <div class="testimonials__navigation">
            <button type="button" class="testimonials__arrow testimonials__arrow--prev" data-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
              {% render 'icon-arrow-left' %}
            </button>
            
            <div class="testimonials__dots" data-dots></div>
            
            <button type="button" class="testimonials__arrow testimonials__arrow--next" data-next aria-label="{{ 'general.slider.next_slide' | t }}">
              {% render 'icon-arrow-right' %}
            </button>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .testimonials {
    padding: 60px 0;
  }
  
  .testimonials__slider {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .testimonials__slides {
    display: flex;
    transition: transform 0.5s ease;
    margin-bottom: 30px;
  }
  
  .testimonials__slide {
    flex: 0 0 100%;
    width: 100%;
    padding: 0 20px;
  }
  
  .testimonials__content {
    text-align: center;
  }
  
  .testimonials__rating {
    margin-bottom: 20px;
    color: var(--color-primary);
  }
  
  .testimonials__rating svg {
    width: 20px;
    height: 20px;
    margin: 0 2px;
  }
  
  .testimonials__text {
    font-size: 1.25rem;
    font-style: italic;
    margin: 0 0 20px;
    padding: 0;
    position: relative;
  }
  
  .testimonials__text::before,
  .testimonials__text::after {
    content: '"';
    font-size: 2rem;
    line-height: 1;
    opacity: 0.3;
    position: absolute;
  }
  
  .testimonials__text::before {
    top: -10px;
    left: -20px;
  }
  
  .testimonials__text::after {
    bottom: -20px;
    right: -20px;
  }
  
  .testimonials__author {
    display: block;
    font-style: normal;
    font-weight: 600;
  }
  
  .testimonials__navigation {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .testimonials__dots {
    display: flex;
    gap: 10px;
    margin: 0 20px;
  }
  
  .testimonials__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(0,0,0,0.1);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  
  .testimonials__dot.active {
    background-color: var(--color-primary);
  }
  
  .testimonials__arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0,0,0,0.05);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }
  
  .testimonials__arrow svg {
    width: 16px;
    height: 16px;
  }
  
  @media (max-width: 767px) {
    .testimonials {
      padding: 40px 0;
    }
    
    .testimonials__text {
      font-size: 1rem;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sliders = document.querySelectorAll('[data-testimonials-slider]');
  
  sliders.forEach(slider => {
    const slides = slider.querySelector('[data-slides]');
    const slideItems = slider.querySelectorAll('.testimonials__slide');
    const dotsContainer = slider.querySelector('[data-dots]');
    const prevButton = slider.querySelector('[data-prev]');
    const nextButton = slider.querySelector('[data-next]');
    
    let currentIndex = 0;
    
    // Create dots if multiple slides
    if (slideItems.length > 1 && dotsContainer) {
      slideItems.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'testimonials__dot';
        dot.dataset.index = index;
        dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
        dotsContainer.appendChild(dot);
      });
      
      updateDots();
    }
    
    // Go to specific slide
    function goToSlide(index) {
      currentIndex = (index + slideItems.length) % slideItems.length;
      slides.style.transform = `translateX(-${currentIndex * 100}%)`;
      updateDots();
    }
    
    // Update dot indicators
    function updateDots() {
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('.testimonials__dot');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === currentIndex);
        });
      }
    }
    
    // Next slide
    function nextSlide() {
      goToSlide(currentIndex + 1);
    }
    
    // Previous slide
    function prevSlide() {
      goToSlide(currentIndex - 1);
    }
    
    // Event listeners
    if (prevButton) prevButton.addEventListener('click', prevSlide);
    if (nextButton) nextButton.addEventListener('click', nextSlide);
    
    if (dotsContainer) {
      dotsContainer.addEventListener('click', function(e) {
        const dot = e.target.closest('.testimonials__dot');
        if (dot) {
          goToSlide(parseInt(dot.dataset.index));
        }
      });
    }
    
    // Keyboard navigation
    slider.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        prevSlide();
      } else if (e.key === 'ArrowRight') {
        nextSlide();
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer testimonials"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add customer reviews and testimonials to showcase your store's happy customers.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer name"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "category": "Text",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}