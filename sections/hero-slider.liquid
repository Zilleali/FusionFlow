{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed
  assign slide_height = section.settings.slide_height
  assign show_text_shadow = section.settings.show_text_shadow
-%}

<div class="hero-slider" data-hero-slider data-autoplay="{{ autoplay }}" data-autoplay-speed="{{ autoplay_speed }}">
  <div class="hero-slider__slides" data-slides>
    {% for block in slides %}
      {%- liquid
        assign image = block.settings.image
        assign mobile_image = block.settings.mobile_image | default: image
        assign heading = block.settings.heading
        assign subheading = block.settings.subheading
        assign text_position = block.settings.text_position
        assign button_text = block.settings.button_text
        assign button_link = block.settings.button_link
        assign color_scheme = block.settings.color_scheme
        assign overlay_opacity = block.settings.overlay_opacity
      -%}

      <div class="hero-slider__slide hero-slider__slide--{{ slide_height }} hero-slider__slide--{{ text_position }} color-{{ color_scheme }}" {{ block.shopify_attributes }}>
        <div class="hero-slider__image">
          {% if image != blank %}
            <picture>
              <source media="(max-width: 767px)" srcset="{{ mobile_image | img_url: '800x' }} 1x, {{ mobile_image | img_url: '1600x' }} 2x">
              <source media="(min-width: 768px)" srcset="{{ image | img_url: '1200x' }} 1x, {{ image | img_url: '2400x' }} 2x">
              <img src="{{ image | img_url: '1200x' }}" 
                   alt="{{ image.alt | escape }}" 
                   loading="lazy" 
                   width="{{ image.width }}" 
                   height="{{ image.height }}">
            </picture>
          {% else %}
            <div class="placeholder-background">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
          
          <div class="hero-slider__overlay" style="opacity: {{ overlay_opacity | divided_by: 100.0 }};"></div>
        </div>

        <div class="hero-slider__content {% if show_text_shadow %}hero-slider__content--shadow{% endif %}">
          <div class="container">
            {% if subheading != blank %}
              <div class="hero-slider__subheading">{{ subheading }}</div>
            {% endif %}
            
            {% if heading != blank %}
              <h2 class="hero-slider__heading">{{ heading }}</h2>
            {% endif %}
            
            {% if button_text != blank %}
              <a href="{{ button_link }}" class="hero-slider__button button button--primary">
                {{ button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if slides.size > 1 %}
    <div class="hero-slider__navigation container">
      <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
        {% render 'icon-arrow-left' %}
      </button>
      
      <div class="hero-slider__dots" data-dots></div>
      
      <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-next aria-label="{{ 'general.slider.next_slide' | t }}">
        {% render 'icon-arrow-right' %}
      </button>
    </div>
  {% endif %}
</div>

<style>
  .hero-slider {
    position: relative;
    overflow: hidden;
  }

  .hero-slider__slides {
    display: flex;
    transition: transform 0.5s ease;
    height: 100%;
  }

  .hero-slider__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    min-height: 300px;
  }

  .hero-slider__slide--small {
    height: 400px;
  }

  .hero-slider__slide--medium {
    height: 500px;
  }

  .hero-slider__slide--large {
    height: 600px;
  }

  .hero-slider__slide--full {
    height: 100vh;
    min-height: 600px;
  }

  .hero-slider__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .hero-slider__image img,
  .hero-slider__image .placeholder-background {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-slider__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000;
  }

  .hero-slider__content {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 40px 0;
    color: inherit;
    z-index: 1;
  }

  .hero-slider__content--shadow {
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .hero-slider__subheading {
    font-size: 1.25rem;
    margin-bottom: 15px;
  }

  .hero-slider__heading {
    font-size: 2.5rem;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .hero-slider__button {
    margin-top: 20px;
  }

  .hero-slider__navigation {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .hero-slider__dots {
    display: flex;
    gap: 10px;
    margin: 0 20px;
  }

  .hero-slider__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255,255,255,0.5);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .hero-slider__dot.active {
    background-color: #fff;
  }

  .hero-slider__arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255,255,255,0.8);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .hero-slider__arrow svg {
    width: 16px;
    height: 16px;
  }

  /* Text position variations */
  .hero-slider__slide--center-left .hero-slider__content {
    justify-content: flex-start;
    text-align: left;
  }

  .hero-slider__slide--center-right .hero-slider__content {
    justify-content: flex-end;
    text-align: right;
  }

  .hero-slider__slide--center-center .hero-slider__content {
    justify-content: center;
    text-align: center;
  }

  .hero-slider__slide--bottom-left .hero-slider__content {
    justify-content: flex-start;
    align-items: flex-end;
    text-align: left;
  }

  .hero-slider__slide--bottom-right .hero-slider__content {
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
  }

  .hero-slider__slide--bottom-center .hero-slider__content {
    justify-content: center;
    align-items: flex-end;
    text-align: center;
  }

  /* Color schemes */
  .hero-slider__slide.color-light {
    color: #fff;
  }

  .hero-slider__slide.color-dark {
    color: #333;
  }

  @media (max-width: 767px) {
    .hero-slider__slide--small {
      height: 300px;
    }

    .hero-slider__slide--medium {
      height: 400px;
    }

    .hero-slider__slide--large {
      height: 500px;
    }

    .hero-slider__slide--full {
      height: 80vh;
      min-height: 400px;
    }

    .hero-slider__subheading {
      font-size: 1rem;
    }

    .hero-slider__heading {
      font-size: 1.75rem;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sliders = document.querySelectorAll('[data-hero-slider]');
  
  sliders.forEach(slider => {
    const slides = slider.querySelector('[data-slides]');
    const slideItems = slider.querySelectorAll('.hero-slider__slide');
    const dotsContainer = slider.querySelector('[data-dots]');
    const prevButton = slider.querySelector('[data-prev]');
    const nextButton = slider.querySelector('[data-next]');
    const autoplay = slider.dataset.autoplay === 'true';
    const autoplaySpeed = parseInt(slider.dataset.autoplaySpeed) || 5000;
    
    let currentIndex = 0;
    let intervalId = null;
    
    // Create dots if multiple slides
    if (slideItems.length > 1 && dotsContainer) {
      slideItems.forEach((_, index) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'hero-slider__dot';
        dot.dataset.index = index;
        dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
        dotsContainer.appendChild(dot);
      });
      
      updateDots();
    }
    
    // Go to specific slide
    function goToSlide(index) {
      currentIndex = (index + slideItems.length) % slideItems.length;
      slides.style.transform = `translateX(-${currentIndex * 100}%)`;
      updateDots();
    }
    
    // Update dot indicators
    function updateDots() {
      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('.hero-slider__dot');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === currentIndex);
        });
      }
    }
    
    // Next slide
    function nextSlide() {
      goToSlide(currentIndex + 1);
    }
    
    // Previous slide
    function prevSlide() {
      goToSlide(currentIndex - 1);
    }
    
    // Start autoplay
    function startAutoplay() {
      if (autoplay && slideItems.length > 1) {
        intervalId = setInterval(nextSlide, autoplaySpeed);
      }
    }
    
    // Stop autoplay
    function stopAutoplay() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }
    
    // Event listeners
    if (prevButton) prevButton.addEventListener('click', prevSlide);
    if (nextButton) nextButton.addEventListener('click', nextSlide);
    
    if (dotsContainer) {
      dotsContainer.addEventListener('click', function(e) {
        const dot = e.target.closest('.hero-slider__dot');
        if (dot) {
          goToSlide(parseInt(dot.dataset.index));
        }
      });
    }
    
    // Pause autoplay on hover
    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);
    
    // Keyboard navigation
    slider.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') {
        prevSlide();
      } else if (e.key === 'ArrowRight') {
        nextSlide();
      }
    });
    
    // Initialize
    startAutoplay();
  });
});
</script>

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "hero-slider-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3000,
      "max": 8000,
      "step": 1000,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "select",
      "id": "slide_height",
      "label": "Slide height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_text_shadow",
      "label": "Show text shadow",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended size: 1800x800px"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Recommended size: 800x1000px"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Slide subheading"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            {
              "value": "center-left",
              "label": "Center left"
            },
            {
              "value": "center-right",
              "label": "Center right"
            },
            {
              "value": "center-center",
              "label": "Center center"
            },
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "bottom-right",
              "label": "Bottom right"
            },
            {
              "value": "bottom-center",
              "label": "Bottom center"
            }
          ],
          "default": "center-center"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color scheme",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "dark",
              "label": "Dark"
            }
          ],
          "default": "light"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slider",
      "category": "Image",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}