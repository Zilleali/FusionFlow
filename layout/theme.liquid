{% comment %}
  Fusion Flow - Premium Shopify Theme
  Version: 1.0.0
  Author: ZILL E ALI
  Color Scheme: Primary #D8C9AE, Secondary #575757
  Font: Mosafin
{% endcomment %}

<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#D8C9AE">
  
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
  {%- endif -%}

  {%- capture seo_title -%}
    {{ page_title }}
    {%- if current_tags -%}
      {%- assign meta_tags = current_tags | join: ', ' -%} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}
    {%- endif -%}
    {%- if current_page != 1 -%}
      &ndash; {{ 'general.meta.page' | t: page: current_page }}
    {%- endif -%}
    {%- unless page_title contains shop.name -%}
      &ndash; {{ shop.name }}
    {%- endunless -%}
  {%- endcapture -%}
  <title>{{ seo_title }}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'social-meta-tags' %}
  
  <!-- Mosafin Font -->
  <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/mosafin" media="print" onload="this.media='all'">
  
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'theme-settings.css' | asset_url | stylesheet_tag }}
  
  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.theme = {
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        cartEmpty: {{ 'cart.general.empty' | t | json }},
        cartTermsConfirmation: {{ 'cart.general.terms' | t | json }}
      },
      moneyFormat: {{ shop.money_format | json }},
      moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
      ajaxCartEnable: {{ settings.ajax_cart_enable | json }},
      primaryColor: '#D8C9AE',
      secondaryColor: '#575757'
    };
  </script>

  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }} {% if settings.enable_boxed_layout %}body-boxed{% endif %}" data-color-scheme="primary">
  <a class="skip-to-content-link visually-hidden" href="#MainContent">
    {{ "accessibility.skip_to_text" | t }}
  </a>

  {% sections 'header-group' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'mobile-navigation' %}

  <!-- Ajax Cart Drawer -->
  <div id="CartDrawer" class="cart-drawer drawer drawer--right">
    <div class="cart-drawer__inner">
      <div class="cart-drawer__header">
        <h2 class="cart-drawer__title">{{ 'cart.general.title' | t }}</h2>
        <button type="button" class="cart-drawer__close" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon-close' %}
        </button>
      </div>
      <div class="cart-drawer__content" id="CartDrawerContent">
        <!-- Ajax cart content will be injected here -->
      </div>
    </div>
  </div>

  <!-- Quick View Modal -->
  <div id="QuickView" class="quick-view-modal modal">
    <div class="quick-view-modal__inner">
      <button type="button" class="quick-view-modal__close" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>
      <div class="quick-view-modal__content" id="QuickViewContent">
        <!-- Quick view content will be injected here -->
      </div>
    </div>
  </div>

  <!-- Search Modal -->
  <div id="SearchModal" class="search-modal modal">
    <div class="search-modal__inner">
      <button type="button" class="search-modal__close" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>
      <div class="search-modal__content">
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
          <input type="hidden" name="type" value="product">
          <input type="search"
                name="q"
                id="SearchInput"
                class="search-modal__input"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.placeholder' | t }}"
                aria-label="{{ 'general.search.placeholder' | t }}"
                autocomplete="off">
          <button type="submit" class="search-modal__submit" aria-label="{{ 'general.search.submit' | t }}">
            {% render 'icon-search' %}
          </button>
        </form>
        <div class="search-modal__results" id="SearchResults">
          <!-- Search results will be injected here -->
        </div>
      </div>
    </div>
  </div>

  <!-- Theme Scripts -->
  <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'ajax-cart.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
  
  {% if settings.enable_lazy_loading %}
    <script src="{{ 'lazysizes.js' | asset_url }}" async="async"></script>
  {% endif %}
</body>
</html>